---
/* Closing green band, reused at the foot of every page. */
interface Props {
  title: string
  lead?: string
  href?: string
  label?: string
}

const {
  title,
  lead = 'Tell us what you are trying to build. If we are not the right fit, we will say so.',
  href = '/contact',
  label = 'Start a project',
} = Astro.props
---

<section class="band-green pattern-geo">
  <div class="wrap py-16 text-center sm:py-20">
    <h2 class="t-h2 text-white" data-reveal>{title}</h2>
    <p class="mx-auto mt-5 max-w-xl text-[15px] leading-[1.9] text-white/75" data-reveal style="--reveal-delay:80ms">
      {lead}
    </p>
    <div class="mt-9" data-reveal style="--reveal-delay:150ms">
      <a href={href} class="btn btn-outline">{label}</a>
    </div>
  </div>
</section>
