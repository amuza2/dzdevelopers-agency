---
/*
  The subheader band used at the top of every inner page: the template's
  cityscape photograph under a charcoal veil, thin Lato heading centred on top.
*/
interface Props {
  eyebrow: string
  title: string
  lead?: string
  image?: string
}

const {
  eyebrow,
  title,
  lead,
  image = '/images/home_agency_subheader.jpg',
} = Astro.props
---

<section class="relative isolate overflow-hidden bg-ink-900">
  <img
    src={image}
    alt=""
    width="2000"
    height="550"
    class="absolute inset-0 -z-10 h-full w-full object-cover opacity-65"
    aria-hidden="true"
  />
  <div class="absolute inset-0 -z-10 bg-ink-900/45" aria-hidden="true"></div>

  <div class="wrap relative py-20 text-center sm:py-24">
    <p class="eyebrow text-brand-200" data-reveal>{eyebrow}</p>
    <h1 class="t-hero mx-auto mt-5 max-w-3xl text-white" data-reveal style="--reveal-delay:80ms">
      {title}
    </h1>
    {
      lead && (
        <p
          class="mx-auto mt-6 max-w-2xl text-[15.5px] leading-[1.9] text-white/65"
          data-reveal
          style="--reveal-delay:150ms"
        >
          {lead}
        </p>
      )
    }
  </div>
</section>
