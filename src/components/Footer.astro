---
const year = new Date().getFullYear()

const columns = [
  {
    title: 'Studio',
    links: [
      { href: '/about', label: 'About us' },
      { href: '/team', label: 'Our team' },
      { href: '/contact', label: 'Contact' },
    ],
  },
  {
    title: 'Services',
    links: [
      { href: '/services', label: 'Web applications' },
      { href: '/services', label: 'Mobile applications' },
      { href: '/services', label: 'Cloud & deployment' },
    ],
  },
]

const socials = [
  { href: 'https://github.com/amuza2', label: 'GitHub' },
  { href: 'https://www.linkedin.com/in/mohammed-chami-dev/', label: 'LinkedIn' },
]
---

<footer class="band-dark border-t border-white/[0.08]">
  <div class="wrap grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1.2fr]">
    <div>
      <a href="/" class="flex items-baseline gap-1 no-underline" aria-label="DZ Developers — home">
        <span class="font-display text-[22px] font-light text-white">DZ</span>
        <span class="font-display text-[22px] font-light text-brand-500">Developers</span>
      </a>
      <p class="mt-5 max-w-xs text-[14px] leading-[1.85] text-ink-400">
        A software studio building web and mobile products — and the
        infrastructure that keeps them running.
      </p>
      <ul class="mt-6 space-y-2">
        {
          socials.map((social) => (
            <li>
              <a
                href={social.href}
                rel="noopener noreferrer"
                target="_blank"
                class="text-[12px] uppercase tracking-[0.14em] text-ink-400 no-underline transition-colors duration-300 hover:text-brand-500"
              >
                {social.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {
      columns.map((column) => (
        <div>
          <h2 class="text-[11px] uppercase tracking-[0.2em] text-white/45">{column.title}</h2>
          <ul class="mt-5 space-y-2.5">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-[14px] text-ink-400 no-underline transition-colors duration-300 hover:text-white"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <div>
      <h2 class="text-[11px] uppercase tracking-[0.2em] text-white/45">Get in touch</h2>
      <p class="mt-5 text-[14px] leading-[1.85] text-ink-400">
        Tell us what you are building.<br />We reply within one working day.
      </p>
      <a
        href="mailto:info@dzdevelopers.com"
        class="mt-4 inline-block border-b border-white/25 pb-1 text-[14px] text-white no-underline transition-colors duration-300 hover:border-brand-500 hover:text-brand-500"
      >
        info@dzdevelopers.com
      </a>
      <p class="mt-5 text-[13px] text-ink-500">Algeria — working remotely</p>
    </div>
  </div>

  <div class="border-t border-white/[0.08]">
    <div class="wrap flex flex-wrap items-center justify-between gap-3 py-6 text-[11px] uppercase tracking-[0.14em] text-white/35">
      <p>© {year} DZ Developers. All rights reserved.</p>
      <a href="mailto:info@dzdevelopers.com" class="text-white/35 no-underline transition-colors hover:text-white">
        info@dzdevelopers.com
      </a>
    </div>
  </div>
</footer>
