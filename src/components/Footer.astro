---
const year = new Date().getFullYear()

const columns = [
  {
    title: 'Company',
    links: [
      { href: '/about', label: 'About us' },
      { href: '/team', label: 'Team' },
      { href: '/contact', label: 'Contact' },
    ],
  },
  {
    title: 'Services',
    links: [
      { href: '/services', label: 'Web applications' },
      { href: '/services', label: 'APIs & integrations' },
      { href: '/services', label: 'Cloud & DevOps' },
    ],
  },
]

const socials = [
  { href: 'https://github.com/amuza2', label: 'GitHub' },
  { href: 'https://www.linkedin.com/in/mohammed-chami-dev/', label: 'LinkedIn' },
]
---

<footer class="band-dark">
  <div class="wrap grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="text-[20px] font-light text-white">
        DZ<span class="text-brand-500">Developers</span>
      </p>
      <p class="mt-4 text-[13px] leading-[23px] text-white/55">
        A software studio building web applications, APIs and cloud
        infrastructure for teams that need it done properly.
      </p>
      <ul class="mt-6 flex gap-5">
        {
          socials.map((social) => (
            <li>
              <a
                href={social.href}
                rel="noopener noreferrer"
                target="_blank"
                class="text-[13px] text-white/55 no-underline transition-colors hover:text-white"
              >
                {social.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {
      columns.map((column) => (
        <div>
          <h2 class="text-[13px] uppercase tracking-[0.09em] text-white/40">
            {column.title}
          </h2>
          <ul class="mt-5 space-y-2.5">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-[13px] text-white/55 no-underline transition-colors hover:text-white"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <div>
      <h2 class="text-[13px] uppercase tracking-[0.09em] text-white/40">
        Get in touch
      </h2>
      <p class="mt-5 text-[13px] leading-[23px] text-white/55">
        Tell us what you are building.<br />
        We reply within one working day.
      </p>
      <a
        href="mailto:info@dzdevelopers.com"
        class="mt-3 inline-block border-b border-white/30 pb-0.5 text-[13px] text-white no-underline transition-colors hover:border-white"
      >
        info@dzdevelopers.com
      </a>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="wrap flex flex-wrap items-center justify-between gap-3 py-6 text-[12px] text-white/40">
      <p>© {year} DZ Developers. All rights reserved.</p>
      <a
        href="mailto:info@dzdevelopers.com"
        class="text-white/40 no-underline transition-colors hover:text-white"
      >
        info@dzdevelopers.com
      </a>
    </div>
  </div>
</footer>
