---
/*
  The full-width photograph that breaks up a page — a "band" with a picture
  instead of a flat colour. Purely decorative, so it is hidden from assistive
  technology and never carries a heading.

  `position` controls which slice of the image survives the crop; the default
  keeps the subject's face in frame for section_bg.jpeg (the source is only
  1024x682, so a 1440px band shows the top third of it).
*/
interface Props {
  image?: string
  position?: string
  height?: string
  alt?: string
}

const {
  image = '/images/section_bg.jpeg',
  position = 'object-[50%_6%]',
  height = 'h-[240px] sm:h-[360px]',
  alt = '',
} = Astro.props
---

<section class="relative isolate overflow-hidden bg-ink-900" aria-hidden="true">
  <img
    src={image}
    alt={alt}
    class={`w-full object-cover ${position} ${height}`}
    loading="lazy"
    decoding="async"
  />
</section>
