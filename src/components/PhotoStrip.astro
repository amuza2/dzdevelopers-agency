---
/*
  The full-width picture that breaks up a page — a "band" with an image
  instead of a flat colour. Purely decorative, so it is hidden from assistive
  technology and never carries a heading.

  The default is the studio artwork (skyline plus green facets): at 1920px wide
  it fills a 1440px band without being upscaled, and its own contrast carries
  the band, so no overlay is needed.
*/
interface Props {
  image?: string
  position?: string
  height?: string
  alt?: string
}

const {
  image = '/images/home_agency_section_2.jpg',
  position = 'object-[50%_45%]',
  height = 'h-[240px] sm:h-[360px]',
  alt = '',
} = Astro.props
---

<section class="relative isolate overflow-hidden bg-ink-900" aria-hidden="true">
  <img
    src={image}
    alt={alt}
    class={`w-full object-cover ${position} ${height}`}
    loading="lazy"
    decoding="async"
  />
</section>
