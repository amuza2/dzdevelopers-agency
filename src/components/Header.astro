---
import Icon from './Icon.astro'

const links = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/about', label: 'About' },
  { href: '/team', label: 'Team' },
  { href: '/contact', label: 'Contact' },
]

const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href))
---

<header
  transition:name="site-header"
  class="sticky top-0 z-50 border-b border-white/[0.07] bg-ink-900"
>
  <div class="wrap flex h-[72px] items-center justify-between gap-8">
    <a href="/" class="flex items-baseline gap-1 no-underline" aria-label="DZ Developers — home">
      <span class="font-display text-[22px] font-light tracking-[0.01em] text-white">DZ</span>
      <span class="font-display text-[22px] font-light tracking-[0.01em] text-brand-500">Developers</span>
    </a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-8">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
                class={`relative flex h-[72px] items-center text-[11.5px] uppercase tracking-[0.16em] no-underline transition-colors duration-300 ${
                  isCurrent(link.href) ? 'text-white' : 'text-ink-400 hover:text-white'
                }`}
              >
                {link.label}
                {
                  isCurrent(link.href) && (
                    <span class="absolute bottom-0 left-0 right-0 h-[2px] bg-brand-500" />
                  )
                }
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="/contact"
        class="hidden border border-white/40 px-6 py-2.5 text-[11px] uppercase tracking-[0.16em] text-white no-underline transition-colors duration-300 hover:border-brand-500 hover:bg-brand-500 sm:inline-block"
      >
        Start a project
      </a>

      <button
        type="button"
        data-menu-toggle
        class="inline-flex h-9 w-9 items-center justify-center border border-white/25 text-white/80 transition-colors hover:border-white/60 hover:text-white md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle navigation"
      >
        <Icon name="menu" size={17} />
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    data-menu-panel
    class="grid grid-rows-[0fr] overflow-hidden transition-all duration-300 md:hidden"
  >
    <div class="min-h-0">
      <ul class="wrap border-t border-white/10 py-3">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class={`block border-b border-white/[0.06] py-3 text-[12px] uppercase tracking-[0.16em] no-underline transition-colors ${
                  isCurrent(link.href) ? 'text-brand-500' : 'text-ink-400 hover:text-white'
                }`}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="pt-4 pb-2">
          <a
            href="/contact"
            class="block border border-white/40 px-4 py-3 text-center text-[11px] uppercase tracking-[0.16em] text-white no-underline"
          >
            Start a project
          </a>
        </li>
      </ul>
    </div>
  </div>
</header>

<script>
  function bindMenu() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')
    const panel = document.querySelector<HTMLElement>('[data-menu-panel]')
    if (!toggle || !panel || toggle.dataset.bound === 'true') return

    toggle.dataset.bound = 'true'
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open))
      panel.style.gridTemplateRows = open ? '1fr' : '0fr'
    }

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true')
    })

    panel.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false)
    })
  }

  document.addEventListener('astro:page-load', bindMenu)
  document.addEventListener('astro:after-swap', bindMenu)
</script>
