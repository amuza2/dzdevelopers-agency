---
const links = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/about', label: 'About' },
  { href: '/team', label: 'Team' },
  { href: '/contact', label: 'Contact' },
]

const path = Astro.url.pathname.replace(/\/$/, '') || '/'
---

<header class="sticky top-0 z-40 bg-ink-900">
  <div class="wrap flex items-center justify-between gap-6 py-4">
    <a href="/" class="flex items-center gap-2.5 no-underline" aria-label="DZ Developers — home">
      <!-- Text mark rather than an image: no extra request, sharp at any size,
           and nothing to break. Swap for a real logo file when you have one. -->
      <span class="text-[20px] font-light tracking-[0.01em] text-white">
        DZ<span class="text-brand-500">Developers</span>
      </span>
    </a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-8">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={path === link.href ? 'page' : undefined}
                class={`text-[13px] uppercase tracking-[0.09em] no-underline transition-colors ${
                  path === link.href
                    ? 'text-brand-500'
                    : 'text-white/75 hover:text-white'
                }`}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="/contact"
        class="hidden border border-white/40 px-6 py-2 text-[13px] uppercase tracking-[0.09em] text-white no-underline transition-colors hover:bg-white hover:text-ink-900 sm:inline-block"
      >
        Start a project
      </a>

      <button
        type="button"
        id="menu-toggle"
        class="inline-flex h-10 w-10 items-center justify-center border border-white/30 text-white/80 md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle navigation"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" hidden class="border-t border-white/10 md:hidden">
    <ul class="wrap space-y-1 py-3">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="block px-3 py-2 text-[13px] uppercase tracking-[0.09em] text-white/80 no-underline hover:text-white"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="pt-1">
        <a
          href="/contact"
          class="block border border-white/40 px-3 py-2 text-center text-[13px] uppercase tracking-[0.09em] text-white no-underline"
        >
          Start a project
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle')
  const menu = document.getElementById('mobile-menu')

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true'
    toggle.setAttribute('aria-expanded', String(!isOpen))
    menu?.toggleAttribute('hidden', isOpen)
  })
</script>
