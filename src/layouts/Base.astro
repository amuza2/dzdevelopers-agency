---
import '../styles/global.css'
import ClientRouter from 'astro/components/ClientRouter.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

interface Props {
  title: string
  description: string
  image?: string
}

const {
  title,
  description,
  image = '/images/home_agency_subheader.jpg',
} = Astro.props

const site = Astro.site ?? new URL('https://agency.dzdevelopers.com')
const canonical = new URL(Astro.url.pathname, site).href
const ogImage = new URL(image, site).href

// Organization schema helps search engines build a knowledge panel and is the
// baseline structured data for a business site.
const organization = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'DZ Developers',
  url: site.href,
  logo: new URL('/images/agency.png', site).href,
  image: ogImage,
  description,
  areaServed: 'DZ',
  sameAs: [
    'https://github.com/amuza2',
    'https://www.linkedin.com/in/mohammed-chami-dev/',
  ],
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/images/favicon.ico" sizes="any" />
    <meta name="theme-color" content="#2c2c2c" />

    <!-- Reveal styles only arm when JS is available, so nothing is ever left
         invisible for crawlers or no-script readers. -->
    <script is:inline>
      document.documentElement.classList.add('js')
    </script>

    <!-- Lato 300 is the template's display face; Roboto handles body copy and
         the small uppercase labels. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&family=Roboto:wght@300;400;500&display=swap"
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DZ Developers" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(organization)} />

    <ClientRouter />
  </head>

  <body class="flex min-h-screen flex-col overflow-x-hidden">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-ink-900 focus:px-4 focus:py-2 focus:text-sm focus:text-white"
    >
      Skip to content
    </a>

    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Staggered reveal-on-scroll, re-run after every client-side navigation.
      function initReveal() {
        const items = document.querySelectorAll('[data-reveal]:not(.is-visible)')

        if (!('IntersectionObserver' in window)) {
          items.forEach((item) => item.classList.add('is-visible'))
          return
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return
              entry.target.classList.add('is-visible')
              observer.unobserve(entry.target)
            })
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        )

        // Anything already on screen is shown straight away — the page-level
        // transition already animates the entrance, and this guarantees the
        // hero is never left hidden.
        const viewportHeight = window.innerHeight || document.documentElement.clientHeight

        items.forEach((item) => {
          const rect = item.getBoundingClientRect()
          if (rect.top < viewportHeight * 0.94 && rect.bottom > 0) {
            item.classList.add('is-visible')
          } else {
            observer.observe(item)
          }
        })
      }

      // ClientRouter replaces <html>'s attributes with the incoming document's,
      // which would strip the .js marker and stop the reveal styles applying.
      document.addEventListener('astro:before-swap', (event) => {
        event.newDocument.documentElement.classList.add('js')
      })

      document.addEventListener('astro:page-load', initReveal)
      document.addEventListener('astro:after-swap', initReveal)

      initReveal()
    </script>
  </body>
</html>
