---
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'
import PhotoStrip from '../components/PhotoStrip.astro'
import Icon from '../components/Icon.astro'
import { EMAIL, PHONE } from '../data/contact'
---

<Base
  title="Contact — DZ Developers"
  description="Get in touch about a web application, mobile app, API or deployment project."
>
  <PageHeader
    eyebrow="Contact"
    title="Tell us what you are trying to build"
    lead="Pick whichever suits you — email, a call, or a quick message on WhatsApp. You will get an honest opinion on whether we can help, and a reply within one working day."
  />

  <section class="section">
    <div class="wrap">
      <div class="text-center" data-reveal>
        <p class="eyebrow text-ink-400">Get in touch</p>
        <h2 class="t-h2 mt-4">Three ways to reach us</h2>
        <hr class="rule mx-auto mt-8 w-16 border-brand-500" />
      </div>

      <ul class="mt-14 grid gap-10 sm:grid-cols-3">
        <li class="flex flex-col border-t border-ink-200 pt-6" data-reveal>
          <span class="icon-ring border-ink-200 text-brand-500">
            <Icon name="mail" size={24} />
          </span>
          <h3 class="mt-5 font-display text-[19px] font-light text-ink-700">Email</h3>
          <p class="mt-2 text-[13.5px] leading-[1.85] text-ink-500">
            Best for briefs, documents and anything long.
          </p>
          <a
            href={`mailto:${EMAIL}`}
            class="mt-auto inline-block self-start border-b border-ink-200 pb-1 pt-5 font-display text-[17px] font-light text-ink-700 no-underline transition-colors duration-300 hover:border-brand-500 hover:text-brand-500"
          >
            {EMAIL}
          </a>
        </li>

        <li class="flex flex-col border-t border-ink-200 pt-6" data-reveal style="--reveal-delay:80ms">
          <span class="icon-ring border-ink-200 text-brand-500">
            <Icon name="smartphone" size={24} />
          </span>
          <h3 class="mt-5 font-display text-[19px] font-light text-ink-700">Phone</h3>
          <p class="mt-2 text-[13.5px] leading-[1.85] text-ink-500">
            Best for a quick conversation during working hours.
          </p>
          <a
            href={`tel:${PHONE.tel}`}
            class="mt-auto inline-block self-start border-b border-ink-200 pb-1 pt-5 font-display text-[17px] font-light text-ink-700 no-underline transition-colors duration-300 hover:border-brand-500 hover:text-brand-500"
          >
            {PHONE.display}
          </a>
        </li>

        <li class="flex flex-col border-t border-ink-200 pt-6" data-reveal style="--reveal-delay:160ms">
          <span class="icon-ring border-ink-200 text-brand-500">
            <Icon name="chat" size={24} />
          </span>
          <h3 class="mt-5 font-display text-[19px] font-light text-ink-700">WhatsApp</h3>
          <p class="mt-2 text-[13.5px] leading-[1.85] text-ink-500">
            The quickest way to ask a question or send a photo of what you have.
          </p>
          <a
            href={PHONE.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-auto inline-flex items-center gap-2 self-start border-b border-ink-200 pb-1 pt-5 font-display text-[17px] font-light text-ink-700 no-underline transition-colors duration-300 hover:border-brand-500 hover:text-brand-500"
          >
            Message us on WhatsApp
            <Icon name="arrow-up-right" size={15} />
          </a>
        </li>
      </ul>

      <p class="mt-16 text-center text-[13.5px] leading-[1.9] text-ink-500" data-reveal>
        Helpful to include: what the product should do, whether anything already
        exists, and your rough timeline.
      </p>
    </div>
  </section>

  <!-- Studio photograph to close the page, as the template does. -->
  <PhotoStrip height="h-[260px] sm:h-[340px]" />
</Base>
