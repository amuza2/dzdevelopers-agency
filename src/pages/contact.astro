---
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'

const details = [
  { label: 'Email', value: 'info@dzdevelopers.com', href: 'mailto:info@dzdevelopers.com' },
  { label: 'GitHub', value: 'github.com/amuza2', href: 'https://github.com/amuza2' },
  {
    label: 'LinkedIn',
    value: 'in/mohammed-chami-dev',
    href: 'https://www.linkedin.com/in/mohammed-chami-dev/',
  },
]
---

<Base
  title="Contact — DZ Developers"
  description="Get in touch about a web application, API or deployment project."
>
  <PageHeader
    eyebrow="Contact"
    title="Tell us what you are trying to build"
    lead="A few sentences about the problem is enough to start. You will get a reply with an honest opinion on whether we can help."
  />

  <section class="wrap grid gap-12 py-16 sm:py-20 lg:grid-cols-5">
    <div class="lg:col-span-3">
      <form id="contact-form" class="space-y-6" novalidate>
        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="name" class="block text-[13px] uppercase tracking-[0.09em] text-ink-500">
              Your name
            </label>
            <input
              id="name"
              name="name"
              type="text"
              required
              autocomplete="name"
              class="mt-2 w-full border border-ink-100 bg-white px-3 py-2.5 text-[14px] outline-none transition-colors focus:border-brand-600"
            />
          </div>
          <div>
            <label for="email" class="block text-[13px] uppercase tracking-[0.09em] text-ink-500">
              Email
            </label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class="mt-2 w-full border border-ink-100 bg-white px-3 py-2.5 text-[14px] outline-none transition-colors focus:border-brand-600"
            />
          </div>
        </div>

        <div>
          <label for="message" class="block text-[13px] uppercase tracking-[0.09em] text-ink-500">
            What do you need?
          </label>
          <textarea
            id="message"
            name="message"
            rows="6"
            required
            class="mt-2 w-full border border-ink-100 bg-white px-3 py-2.5 text-[14px] outline-none transition-colors focus:border-brand-600"
          ></textarea>
        </div>

        <button type="submit" class="btn-solid">Send message</button>

        <p class="text-[12px] leading-[21px] text-ink-500">
          This opens your email client with the message filled in — no form
          service, nothing stored in between.
        </p>
      </form>

      <noscript>
        <p class="mt-4 border border-ink-100 bg-ink-50 p-4 text-[13px] text-ink-700">
          JavaScript is off, so the form cannot compose an email. Write to
          <a class="text-brand-600 underline" href="mailto:info@dzdevelopers.com">info@dzdevelopers.com</a>
          directly.
        </p>
      </noscript>
    </div>

    <aside class="lg:col-span-2">
      <h2 class="text-[13px] uppercase tracking-[0.09em] text-ink-300">
        Or reach out directly
      </h2>
      <ul class="mt-6 space-y-5">
        {
          details.map((detail) => (
            <li>
              <p class="text-[11px] uppercase tracking-[0.12em] text-ink-300">
                {detail.label}
              </p>
              <a
                href={detail.href}
                rel="noopener noreferrer"
                class="mt-1 inline-block border-b border-brand-200 pb-0.5 text-[16px] font-light text-brand-600 no-underline transition-colors hover:border-brand-600 hover:text-brand-700"
              >
                {detail.value}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mt-10 border-t border-ink-100 pt-6">
        <h3 class="text-[13px] uppercase tracking-[0.09em] text-ink-300">Helpful to include</h3>
        <ul class="mt-4 space-y-1 text-[13px] leading-[23px] text-ink-500">
          <li>— What the product should do</li>
          <li>— Whether anything already exists</li>
          <li>— Your rough timeline</li>
        </ul>
      </div>
    </aside>
  </section>
</Base>

<script>
  // No backend: compose a mailto so the form is genuinely functional.
  const form = document.getElementById('contact-form')

  form?.addEventListener('submit', (event) => {
    event.preventDefault()

    const data = new FormData(form)
    const name = String(data.get('name') ?? '').trim()
    const email = String(data.get('email') ?? '').trim()
    const message = String(data.get('message') ?? '').trim()

    if (!name || !email || !message) {
      form.reportValidity()
      return
    }

    const subject = encodeURIComponent(`Project enquiry from ${name}`)
    const body = encodeURIComponent(`${message}\n\n— ${name} (${email})`)
    window.location.href = `mailto:info@dzdevelopers.com?subject=${subject}&body=${body}`
  })
</script>
