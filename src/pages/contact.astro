---
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'
import PhotoStrip from '../components/PhotoStrip.astro'
import { EMAIL, PHONES } from '../data/contact'

const details = [
  { label: 'Email', value: EMAIL, href: `mailto:${EMAIL}` },
  ...PHONES.map((phone) => ({ label: 'Phone', value: phone.display, href: `tel:${phone.tel}` })),
]

const field =
  'mt-2 w-full border border-ink-200 bg-white px-4 py-3 font-sans text-[15px] text-ink-700 outline-none transition-colors duration-300 focus:border-brand-500'

/*
  Web3Forms access key — free, no account needed: go to https://web3forms.com,
  enter support@dzdevelopers.com, and the key arrives by email. Paste it between
  the quotes below. Until it is set, the form falls back to opening the
  visitor's mail client, so nothing silently breaks.
*/
const FORM_ACCESS_KEY = ''
---

<Base
  title="Contact — DZ Developers"
  description="Get in touch about a web application, mobile app, API or deployment project."
>
  <PageHeader
    eyebrow="Contact"
    title="Tell us what you are trying to build"
    lead="A few sentences about the problem is enough to start. You will get an honest opinion on whether we can help — and a reply within one working day."
  />

  <section class="section">
    <div class="wrap grid gap-14 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
      <div data-reveal>
        <h2 class="font-display text-[21px] font-light text-ink-700">Start the conversation</h2>
        <p class="mt-2 text-[14px] leading-[1.85] text-ink-500">
          Goes straight to our inbox. We reply within one working day.
        </p>

        <form
          id="contact-form"
          class="mt-8 space-y-6"
          data-email={EMAIL}
          data-endpoint="https://api.web3forms.com/submit"
          data-access-key={FORM_ACCESS_KEY}
          novalidate
        >
          <!-- Honeypot: bots fill this, humans never see it. -->
          <input
            type="text"
            name="_honey"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            class="absolute h-0 w-0 overflow-hidden opacity-0"
          />
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="name" class="text-[10.5px] uppercase tracking-[0.2em] text-ink-400">
                Your name
              </label>
              <input id="name" name="name" type="text" required autocomplete="name" placeholder="Jane Doe" class={field} />
            </div>
            <div>
              <label for="email" class="text-[10.5px] uppercase tracking-[0.2em] text-ink-400">
                Email
              </label>
              <input id="email" name="email" type="email" required autocomplete="email" placeholder="jane@company.com" class={field} />
            </div>
          </div>

          <div>
            <label for="kind" class="text-[10.5px] uppercase tracking-[0.2em] text-ink-400">
              What do you need?
            </label>
            <select id="kind" name="kind" class={field}>
              <option>Web application</option>
              <option>Mobile application</option>
              <option>API or integration</option>
              <option>Deployment or infrastructure</option>
              <option>Maintenance of an existing product</option>
              <option>Not sure yet</option>
            </select>
          </div>

          <div>
            <label for="message" class="text-[10.5px] uppercase tracking-[0.2em] text-ink-400">
              About the project
            </label>
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              placeholder="What should it do, what exists already, and when do you need it?"
              class={field}
            ></textarea>
          </div>

          <div class="flex flex-wrap items-center gap-5">
            <button type="submit" data-submit class="btn btn-solid">Send message</button>
            <p id="form-status" class="text-[13px] text-ink-500" role="status" aria-live="polite"></p>
          </div>
        </form>

        <noscript>
          <p class="mt-6 border border-ink-200 bg-ink-50 p-4 text-[13.5px] text-ink-600">
            JavaScript is off, so the form cannot be sent. Write to
            <a class="text-brand-500 underline" href={`mailto:${EMAIL}`}>{EMAIL}</a>
            directly.
          </p>
        </noscript>
      </div>

      <aside data-reveal style="--reveal-delay:100ms">
        <h2 class="text-[10.5px] uppercase tracking-[0.2em] text-ink-400">Or reach out directly</h2>

        <ul class="mt-6 divide-y divide-ink-100 border-y border-ink-100">
          {
            details.map((detail) => (
              <li>
                <a
                  href={detail.href}
                  rel="noopener noreferrer"
                  class="group flex items-baseline justify-between gap-6 py-4 no-underline"
                >
                  <span class="text-[10.5px] uppercase tracking-[0.18em] text-ink-400">{detail.label}</span>
                  <span class="font-display text-[16px] font-light text-ink-700 transition-colors duration-300 group-hover:text-brand-500">
                    {detail.value}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </section>

  <!-- Studio photograph to close the page, as the template does. -->
  <PhotoStrip height="h-[260px] sm:h-[340px]" />
</Base>

<script>
  // The site is static, so submissions go to a form relay which emails the
  // address in data-endpoint. Swapping providers is a one-line change here.
  function bindContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null
    const status = document.getElementById('form-status')
    const submit = form?.querySelector<HTMLButtonElement>('[data-submit]') ?? null
    if (!form || form.dataset.bound === 'true') return

    form.dataset.bound = 'true'

    const say = (text: string, tone: 'muted' | 'ok' | 'error' = 'muted') => {
      if (!status) return
      status.textContent = text
      status.classList.toggle('text-brand-600', tone === 'ok')
      status.classList.toggle('text-ink-500', tone === 'muted')
      status.classList.toggle('text-red-700', tone === 'error')
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault()

      const data = new FormData(form)
      const name = String(data.get('name') ?? '').trim()
      const email = String(data.get('email') ?? '').trim()
      const kind = String(data.get('kind') ?? '').trim()
      const message = String(data.get('message') ?? '').trim()

      if (!name || !email || !message) {
        form.reportValidity()
        return
      }

      const endpoint = form.dataset.endpoint
      const accessKey = (form.dataset.accessKey || '').trim()
      const to = form.dataset.email || 'support@dzdevelopers.com'

      // Last-resort path: hand the message to the visitor's mail client. Used
      // when no access key is configured, and whenever the relay fails — an
      // enquiry should never be lost because a third party is down.
      const openMailClient = () => {
        const subject = encodeURIComponent(`${kind} — enquiry from ${name}`)
        const body = encodeURIComponent(
          `${message}\n\nProject type: ${kind}\n\n— ${name} (${email})`,
        )
        say('Opening your mail client…')
        window.location.href = `mailto:${to}?subject=${subject}&body=${body}`
      }

      if (!endpoint || !accessKey) {
        openMailClient()
        return
      }

      if (submit) submit.disabled = true
      say('Sending…')

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            access_key: accessKey,
            subject: `${kind} — enquiry from ${name}`,
            from_name: 'DZ Developers website',
            name,
            email,
            kind,
            message,
          }),
        })

        const result = (await response.json().catch(() => ({}))) as {
          success?: boolean
          message?: string
        }

        if (!response.ok || !result.success) {
          throw new Error(result.message || `HTTP ${response.status}`)
        }

        form.reset()
        say('Thanks — your message is on its way. We reply within one working day.', 'ok')
      } catch (error) {
        openMailClient()
      } finally {
        if (submit) submit.disabled = false
      }
    })
  }

  document.addEventListener('astro:page-load', bindContactForm)
  document.addEventListener('astro:after-swap', bindContactForm)
</script>
