---
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'
import CtaBand from '../components/CtaBand.astro'

/*
  Only real people are listed, and only real photographs are used. The studio
  shot stands in until a portrait exists — swap `photo` when you have one.
*/
const members = [
  {
    label: 'Founder',
    name: 'Mohammed Chami',
    role: 'Founder & Full-stack Engineer',
    bio: 'Builds and maintains applications end to end — Django, Vue, Flutter, PostgreSQL and the deployment pipeline behind them. Works directly with every client, from the first call to the release.',
    links: [
      { href: 'https://github.com/amuza2', label: 'GitHub' },
      { href: 'https://www.linkedin.com/in/mohammed-chami-dev/', label: 'LinkedIn' },
    ],
  },
  {
    label: 'Team',
    name: 'Abdel Illah B.',
    role: 'Cloud & Infrastructure Engineer',
    bio: 'Building production-ready systems with modern cloud infrastructure.',
    links: [
      { href: 'https://www.linkedin.com/in/abdelillahbel', label: 'LinkedIn' },
      { href: 'https://www.abdelillah.site/', label: 'Website' },
    ],
  },
]

const collaboration = [
  {
    step: '01',
    title: 'Direct line',
    body: 'One point of contact who is also the person writing the code. No relay, no reinterpretation of your brief.',
  },
  {
    step: '02',
    title: 'Shared repository',
    body: 'You have access to the code and the deployment from day one — including the issues and the decisions behind them.',
  },
  {
    step: '03',
    title: 'Written updates',
    body: 'A short note at the end of each iteration: what shipped, what is next, and anything that changed.',
  },
]
---

<Base
  title="Team — DZ Developers"
  description="The people behind DZ Developers: a small studio building and maintaining web and mobile applications."
>
  <PageHeader
    eyebrow="Team"
    title="The people you will actually talk to"
    lead="No account managers between you and the work — the person on the call is the person building your product."
  />

  <section class="section">
    <div class="wrap space-y-16 lg:space-y-20">
      {
        members.map((member, index) => (
          <article
            class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16"
            data-reveal
            style={`--reveal-delay:${index * 80}ms`}
          >
            <div class="border-t border-ink-200 pt-6">
              <p class="eyebrow text-ink-400">{member.label}</p>
              <h2 class="t-h2 mt-4 text-[28px] sm:text-[34px]">{member.name}</h2>
              <p class="mt-3 text-[11px] uppercase tracking-[0.18em] text-brand-500">{member.role}</p>
            </div>

            <div class="border-t border-ink-200 pt-6">
              <p class="max-w-xl text-[15px] leading-[1.9] text-ink-500">{member.bio}</p>

              <ul class="mt-8 flex flex-wrap gap-3">
                {member.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      rel="noopener noreferrer"
                      target="_blank"
                      class="inline-block border border-ink-200 px-5 py-2.5 text-[11px] uppercase tracking-[0.16em] text-ink-500 no-underline transition-colors duration-300 hover:border-brand-500 hover:bg-brand-500 hover:text-white"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="band-light pattern-geo-light" aria-labelledby="collab-heading">
    <div class="wrap py-20">
      <div class="text-center" data-reveal>
        <p class="eyebrow text-ink-400">How collaboration works</p>
        <h2 id="collab-heading" class="t-h2 mt-4">Small enough to stay direct</h2>
        <hr class="rule mx-auto mt-8 w-16 border-brand-500" />
      </div>

      <ul class="mt-14 grid gap-10 sm:grid-cols-3">
        {
          collaboration.map((item, index) => (
            <li class="border-t border-ink-200 pt-6" data-reveal style={`--reveal-delay:${index * 80}ms`}>
              <span class="font-display text-[34px] font-light leading-none text-brand-500/60">{item.step}</span>
              <h3 class="mt-4 font-display text-[19px] font-light text-ink-700">{item.title}</h3>
              <p class="mt-3 text-[13.5px] leading-[1.9] text-ink-500">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand
    title="Need something built?"
    lead="Tell us what you are trying to do. If we are not the right fit, we will say so — and point you somewhere better."
  />
</Base>
