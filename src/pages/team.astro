---
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'
import CtaBand from '../components/CtaBand.astro'
import Icon from '../components/Icon.astro'

/*
  Only real people are listed. Drop a portrait into /public/images and set
  `photo` to swap the monogram avatar for a real one.
*/
const members = [
  {
    name: 'Mohammed Chami',
    role: 'Founder & Full-stack Engineer',
    initials: 'MC',
    photo: null as string | null,
    bio: 'Builds and maintains applications end to end — Django, Vue, Flutter, PostgreSQL and the deployment pipeline behind them. Works directly with every client, from the first call to the release.',
    links: [
      { href: 'https://github.com/amuza2', label: 'GitHub', icon: 'github' as const },
      {
        href: 'https://www.linkedin.com/in/mohammed-chami-dev/',
        label: 'LinkedIn',
        icon: 'linkedin' as const,
      },
    ],
  },
]

const collaboration = [
  {
    icon: 'code' as const,
    title: 'Direct line',
    body: 'One point of contact who is also the person writing the code. No relay, no reinterpretation of your brief.',
  },
  {
    icon: 'layers' as const,
    title: 'Shared repository',
    body: 'You have access to the code and the deployment from day one — including the issues and the decisions.',
  },
  {
    icon: 'sparkles' as const,
    title: 'Written updates',
    body: 'A short note at the end of each iteration: what shipped, what is next, and anything that changed.',
  },
]
---

<Base
  title="Team — DZ Developers"
  description="The people behind DZ Developers: a small studio building and maintaining web and mobile applications."
>
  <PageHeader
    eyebrow="Team"
    title="The people you will actually talk to"
    lead="No account managers between you and the work — the person on the call is the person building your product."
  />

  <section class="section">
    <div class="wrap">
      {
        members.map((member) => (
          <article class="grid items-center gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16" data-reveal>
            <div class="relative overflow-hidden rounded-[30px] border border-ink-100">
              {member.photo ? (
                <img
                  src={member.photo}
                  alt={`Portrait of ${member.name}`}
                  width="800"
                  height="1000"
                  class="aspect-[4/5] w-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="relative grid aspect-[4/5] w-full place-items-center bg-gradient-to-br from-ink-900 via-ink-800 to-brand-900">
                  <div class="pointer-events-none absolute inset-0 bg-grid opacity-40" aria-hidden="true"></div>
                  <div
                    class="pointer-events-none absolute -bottom-16 left-1/2 h-56 w-56 -translate-x-1/2 rounded-full bg-brand-500/30 blur-3xl"
                    aria-hidden="true"
                  >
                  </div>
                  <span class="relative font-display text-[86px] font-semibold tracking-[-0.06em] text-white/90">
                    {member.initials}
                  </span>
                  <span class="absolute bottom-6 font-mono text-[10px] uppercase tracking-[0.22em] text-white/40">
                    Portrait coming soon
                  </span>
                </div>
              )}
            </div>

            <div>
              <p class="eyebrow text-brand-600">Founder</p>
              <h2 class="t-h2 mt-5 text-[30px] sm:text-[38px]">{member.name}</h2>
              <p class="mt-2 font-mono text-[11px] uppercase tracking-[0.18em] text-brand-600">
                {member.role}
              </p>
              <p class="mt-6 max-w-xl text-[15px] leading-[1.8] text-ink-500">{member.bio}</p>

              <ul class="mt-8 flex flex-wrap gap-3">
                {member.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      rel="noopener noreferrer"
                      target="_blank"
                      class="inline-flex items-center gap-2 rounded-full border border-ink-200 px-4 py-2 text-[13px] text-ink-700 no-underline transition-all duration-300 hover:-translate-y-0.5 hover:border-ink-950 hover:text-ink-950"
                    >
                      <Icon name={link.icon} size={15} />
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section hairline bg-ink-50">
    <div class="wrap">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow text-brand-600">How collaboration works</p>
        <h2 class="t-h2 mt-5">Small enough to stay direct.</h2>
      </div>

      <ul class="mt-12 grid gap-5 sm:grid-cols-3">
        {
          collaboration.map((item, index) => (
            <li class="card card-lift" data-reveal style={`--reveal-delay:${index * 80}ms`}>
              <span class="grid h-11 w-11 place-items-center rounded-xl bg-brand-50 text-brand-600 ring-1 ring-inset ring-brand-100">
                <Icon name={item.icon} size={20} />
              </span>
              <h3 class="t-h3 mt-6">{item.title}</h3>
              <p class="mt-3 text-[14px] leading-[1.7] text-ink-500">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand
    title="Need something built?"
    lead="Tell us what you are trying to do. If we are not the right fit, we will say so — and point you somewhere better."
  />
</Base>
