---
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'
import CtaBand from '../components/CtaBand.astro'

/*
  Placeholder-safe: only one real member is listed. Add the rest of the team
  here (name, role, photo in /public/images) rather than inventing people.
*/
const members = [
  {
    name: 'Mohammed Chami',
    role: 'Founder & Full-stack Engineer',
    photo: '/images/our_team_1.jpg',
    bio: 'Builds and maintains the applications end to end — Django, Vue, PostgreSQL and the deployment pipeline.',
  },
]
---

<Base
  title="Team — DZ Developers"
  description="The people behind DZ Developers: a small studio building and maintaining web applications."
>
  <PageHeader
    eyebrow="Team"
    title="The people you will actually talk to"
    lead="No account managers between you and the work."
  />

  <section class="wrap py-16 sm:py-20">
    <ul class="grid gap-12 sm:grid-cols-2 lg:grid-cols-3">
      {
        members.map((member) => (
          <li>
            <img
              src={member.photo}
              alt={`Portrait of ${member.name}`}
              width="600"
              height="600"
              class="aspect-square w-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <h2 class="h-card mt-6 text-[21px]">
              <span class="u-title">{member.name}</span>
            </h2>
            <p class="mt-3 text-[11px] uppercase tracking-[0.12em] text-ink-300">
              {member.role}
            </p>
            <p class="mt-4 text-[13px] leading-[23px] text-ink-500">{member.bio}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <CtaBand
    title="Need something built?"
    lead="Tell us what you are trying to do. If we are not the right fit, we will say so."
  />
</Base>
