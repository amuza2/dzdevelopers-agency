---
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'
import CtaBand from '../components/CtaBand.astro'
import Icon from '../components/Icon.astro'

const services = [
  {
    icon: 'code' as const,
    title: 'Web application development',
    body: 'Full-stack products built with Django, PostgreSQL and Vue — authentication, permissions, admin tooling and the unglamorous parts that make a product usable.',
    points: ['Custom dashboards', 'Multi-user roles', 'Reporting and exports'],
  },
  {
    icon: 'smartphone' as const,
    title: 'Mobile application development',
    body: 'Cross-platform apps in Flutter that share a codebase, a design language and an API with your web product, so both stay in sync as it grows.',
    points: ['One codebase, iOS & Android', 'Offline-first data', 'Store releases'],
  },
  {
    icon: 'layers' as const,
    title: 'APIs & integrations',
    body: 'REST APIs that are documented and stable, plus integrations with the services you already depend on — payments, email, storage, third parties.',
    points: ['Versioned REST APIs', 'Token authentication', 'Webhook handling'],
  },
  {
    icon: 'cloud' as const,
    title: 'Cloud & deployment',
    body: 'Containerised deployments with TLS, managed databases and automated backups, including a runbook so you are not locked to us for operations.',
    points: ['Docker / Compose', 'Let’s Encrypt TLS', 'Scheduled backups'],
  },
  {
    icon: 'gauge' as const,
    title: 'Performance & SEO',
    body: 'Server-rendered or statically generated pages, correct metadata, structured data and a fast first paint — the things that decide whether you get found.',
    points: ['Core Web Vitals', 'Structured data', 'Sitemaps & canonicals'],
  },
  {
    icon: 'wrench' as const,
    title: 'Maintenance & audits',
    body: 'Ongoing upgrades, monitoring and small features after launch — or an honest review of an existing codebase: what is fragile, what is a risk, what to fix first.',
    points: ['Dependency upgrades', 'Uptime monitoring', 'Prioritised findings'],
  },
]

const engagements = [
  {
    step: '01',
    title: 'Scoped build',
    body: 'A defined product or feature set, delivered in iterations with a fixed price and a written definition of done.',
  },
  {
    step: '02',
    title: 'Launch',
    body: 'Deployment to your domain with TLS, backups and monitoring in place, plus a runbook your team can follow.',
  },
  {
    step: '03',
    title: 'Retainer',
    body: 'Upgrades, monitoring and small features after launch, on a monthly basis you can cancel whenever you like.',
  },
]
---

<Base
  title="Services — DZ Developers"
  description="Web and mobile application development, APIs, cloud deployment, performance and long-term maintenance."
>
  <PageHeader
    eyebrow="Services"
    title="What we can take off your plate"
    lead="Each engagement starts with a short scoping conversation, so we both know what is being built and what is explicitly out of scope."
  />

  <!-- Detailed services, three columns divided by hairlines. -->
  <section class="section" aria-label="Services we offer">
    <div class="wrap">
      <ul class="grid gap-x-10 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((service, index) => (
            <li data-reveal style={`--reveal-delay:${(index % 3) * 70}ms`}>
              <span class="icon-ring border-ink-200 text-brand-500">
                <Icon name={service.icon} size={25} />
              </span>
              <h2 class="mt-6 font-display text-[20px] font-light text-ink-700">{service.title}</h2>
              <p class="mt-3 text-[13.5px] leading-[1.9] text-ink-500">{service.body}</p>
              <ul class="mt-5 space-y-1.5 border-t border-ink-100 pt-4">
                {service.points.map((point) => (
                  <li class="text-[12px] uppercase tracking-[0.12em] text-ink-400">— {point}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Engagement shape, on the charcoal band. -->
  <section class="band-dark" aria-labelledby="engagements-heading">
    <div class="wrap py-20">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow text-brand-500">Engagements</p>
        <h2 id="engagements-heading" class="t-h2 mt-4 text-white">
          Fixed scope, or a monthly retainer
        </h2>
        <p class="mt-5 text-[15px] leading-[1.9] text-white/60">
          Most clients start with a scoped build and move to a retainer once the
          product is live. Both are priced up front, in writing.
        </p>
      </div>

      <ol class="mt-14 grid gap-10 sm:grid-cols-3">
        {
          engagements.map((item, index) => (
            <li class="border-t border-white/20 pt-6" data-reveal style={`--reveal-delay:${index * 80}ms`}>
              <span class="font-display text-[34px] font-light leading-none text-brand-500">{item.step}</span>
              <h3 class="mt-4 font-display text-[19px] font-light text-white">{item.title}</h3>
              <p class="mt-3 text-[13.5px] leading-[1.9] text-white/60">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Closing statement, on solid charcoal — no dimmed photo behind it. -->
  <section class="band-dark">
    <div class="wrap py-16 text-center">
      <p class="mx-auto max-w-3xl font-display text-[22px] font-light leading-[1.6] text-white sm:text-[26px]" data-reveal>
        Not sure which of these you need? Describe the problem and we will tell
        you what it actually requires — even if the answer is “not much”.
      </p>
      <a href="/contact" class="btn btn-outline mt-8" data-reveal style="--reveal-delay:80ms">
        Start a conversation
      </a>
    </div>
  </section>

  <CtaBand
    title="Tell us what you are building"
    lead="A few sentences about the problem is enough to start."
  />
</Base>
