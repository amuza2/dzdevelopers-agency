---
import Base from '../layouts/Base.astro'

/*
  NOTE: the copy and the three "work" cards are placeholders carried over from
  the original template so the layout can be judged. Replace the text and swap
  the project names for real case studies before going live.
*/

const capabilities = [
  {
    title: 'Web applications',
    body: 'Django and Vue products built to handle real data, real users and real growth — not demos.',
  },
  {
    title: 'APIs & integrations',
    body: 'REST APIs, authentication and third-party integrations that other teams can build on.',
  },
  {
    title: 'Cloud & deployment',
    body: 'Containerised deployments, managed databases, TLS and backups — configured and documented.',
  },
  {
    title: 'Data & migrations',
    body: 'We move existing data across without losing a row, and leave a documented way back.',
  },
  {
    title: 'Performance & SEO',
    body: 'Fast pages, clean markup and structured data, so the product can actually be found.',
  },
  {
    title: 'Long-term maintenance',
    body: 'Monitoring, upgrades and small features after launch, so the product keeps working.',
  },
]

const work = [
  {
    name: 'Colett Precision',
    tag: 'Web platform',
    image: '/images/colett.jpg',
    alt: 'Interface of a precision-engineering web platform',
    body: 'A catalogue and quotation platform for a precision-engineering workshop: server-rendered, searchable, and built so non-technical staff can update it themselves.',
  },
  {
    name: 'Infinity Project',
    tag: 'Product design',
    image: '/images/unity.jpg',
    alt: 'Product design case study',
    body: 'A design system and marketing site for a product studio — one component library feeding both the public site and the internal application.',
  },
  {
    name: 'Unity Workspace',
    tag: 'Internal tooling',
    image: '/images/home_agency_section_2.jpg',
    alt: 'Photograph supporting the Unity Workspace case study',
    body: 'An internal workspace that replaced a spreadsheet: roles, audit history and exports, running against the same database as the public site.',
  },
]

const process = [
  { step: '01', title: 'Scope', body: 'We agree on what the product has to do — and what it explicitly will not.' },
  { step: '02', title: 'Build', body: 'Short iterations, with something clickable at the end of each one.' },
  { step: '03', title: 'Ship', body: 'Deployed to your infrastructure, with TLS, backups and a runbook.' },
  { step: '04', title: 'Maintain', body: 'Monitoring and iteration after launch, on a schedule that suits you.' },
]
---

<Base
  title="DZ Developers — Web Applications, APIs & Cloud"
  description="A software studio building web applications, APIs and cloud infrastructure. Django, Vue and PostgreSQL, delivered and maintained."
>
  <!-- Hero — charcoal band, big thin centred type, outlined button. This is the
       template's opening move; the slider it used to sit in is gone. -->
  <section class="band-dark">
    <div class="wrap py-20 text-center sm:py-28">
      <h1 class="h-hero mx-auto max-w-4xl text-[30px] sm:text-[42px] lg:text-[52px]">
        We build software that brings usability, beauty and great impact.
      </h1>
      <a href="/contact" class="btn-outline mt-10">Hire us now</a>
    </div>
  </section>

  <!-- Capabilities — the green band with its lattice, 3 × 2 split by rules. -->
  <section class="band-green pattern-geo" aria-labelledby="capabilities-heading">
    <div class="wrap py-16 sm:py-20">
      <h2 id="capabilities-heading" class="h-section text-[30px] text-white">
        What we provide
      </h2>

      <div class="mt-12">
        <ul class="grid gap-x-12 sm:grid-cols-3">
          {
            capabilities.slice(0, 3).map((item) => (
              <li class="py-8">
                <h3 class="h-card text-[21px]">
                  <a href="/services" class="u-title">{item.title}</a>
                </h3>
                <p class="mt-4 text-[13px] leading-[23px] text-white/75">{item.body}</p>
              </li>
            ))
          }
        </ul>
        <ul class="grid gap-x-12 sm:grid-cols-3">
          {
            capabilities.slice(3).map((item) => (
              <li class="border-t border-white/25 py-8">
                <h3 class="h-card text-[21px]">
                  <a href="/services" class="u-title">{item.title}</a>
                </h3>
                <p class="mt-4 text-[13px] leading-[23px] text-white/75">{item.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Work — stacked image / title / copy blocks, the template's showcase
       rhythm rather than a card grid. -->
  <section class="wrap py-16 sm:py-20" aria-labelledby="work-heading">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <h2 id="work-heading" class="h-section text-[26px] sm:text-[30px]">Selected work</h2>
        <p class="mt-3 max-w-2xl text-[13px] leading-[23px] text-ink-500">
          A sample of the kind of products we build.
        </p>
      </div>
      <a href="/contact" class="text-[13px] uppercase tracking-[0.09em] text-brand-600 no-underline transition-colors hover:text-brand-700">
        Talk about yours &rarr;
      </a>
    </div>

    <div class="mt-12 space-y-16">
      {
        work.map((project) => (
          <article>
            <img
              src={project.image}
              alt={project.alt}
              width="1000"
              height="620"
              class="w-full max-w-3xl object-cover"
              loading="lazy"
              decoding="async"
            />
            <div class="mt-6 max-w-3xl">
              <h3 class="h-card text-[25px]">
                <a href="/contact" class="u-title">{project.name}</a>
              </h3>
              <p class="mt-3 text-[11px] uppercase tracking-[0.12em] text-ink-300">
                {project.tag}
              </p>
              <p class="mt-4 text-[13px] leading-[23px] text-ink-500">{project.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Process — centred heading with the rule running off to the right, then a
       4-up grid, as in the template's "We provide awesomness" block. -->
  <section class="wrap py-16 sm:py-20" aria-labelledby="process-heading">
    <div class="flex items-center gap-8">
      <h2 id="process-heading" class="h-section shrink-0 text-[26px] sm:text-[30px]">
        How we work
      </h2>
      <hr class="rule flex-1" />
    </div>
    <p class="mt-4 max-w-2xl text-[13px] leading-[23px] text-ink-500">
      No surprises. You always know what stage we are at and what comes next.
    </p>

    <ol class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        process.map((item) => (
          <li class="border-t border-ink-100 pt-6">
            <span class="block text-[40px] font-light leading-none text-brand-200">
              {item.step}
            </span>
            <h3 class="h-card mt-5 text-[21px]">
              <span class="u-title">{item.title}</span>
            </h3>
            <p class="mt-3 text-[13px] leading-[23px] text-ink-500">{item.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- CTA — the green band again, closing the page before the footer. -->
  <section class="band-green pattern-geo">
    <div class="wrap py-16 text-center sm:py-20">
      <h2 class="h-section text-[26px] text-white sm:text-[30px]">
        Have something that needs building?
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-[13px] leading-[23px] text-white/75">
        Tell us what you are trying to do. If we are not the right fit, we will
        say so.
      </p>
      <a href="/contact" class="btn-outline mt-9">Get in touch</a>
    </div>
  </section>

  <!-- Contact strip — three ruled columns, as in the original footer lead-in. -->
  <section class="wrap grid gap-8 py-14 sm:grid-cols-3" aria-label="Contact details">
    <div>
      <h3 class="text-[13px] uppercase tracking-[0.09em] text-ink-300">Email us</h3>
      <a
        href="mailto:info@dzdevelopers.com"
        class="mt-2 inline-block border-b border-brand-200 pb-0.5 text-[18px] font-light text-brand-600 no-underline transition-colors hover:border-brand-600 hover:text-brand-700"
      >
        info@dzdevelopers.com
      </a>
    </div>
    <div>
      <h3 class="text-[13px] uppercase tracking-[0.09em] text-ink-300">Start a project</h3>
      <a
        href="/contact"
        class="mt-2 inline-block border-b border-brand-200 pb-0.5 text-[18px] font-light text-brand-600 no-underline transition-colors hover:border-brand-600 hover:text-brand-700"
      >
        Tell us about the work
      </a>
    </div>
    <div>
      <h3 class="text-[13px] uppercase tracking-[0.09em] text-ink-300">Where we are</h3>
      <p class="mt-2 text-[18px] font-light text-brand-600">Algeria — working remotely</p>
    </div>
  </section>
</Base>
