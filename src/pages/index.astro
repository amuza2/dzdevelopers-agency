---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import CtaBand from '../components/CtaBand.astro'
import PhotoStrip from '../components/PhotoStrip.astro'
import { EMAIL } from '../data/contact'

const services = [
  {
    icon: 'code' as const,
    title: 'Web applications',
    body: 'Server-rendered products with real accounts, permissions and reporting — built to survive the first hundred users.',
  },
  {
    icon: 'smartphone' as const,
    title: 'Mobile apps',
    body: 'Cross-platform iOS and Android apps in Flutter, sharing one codebase and one API with the web product.',
  },
  {
    icon: 'layers' as const,
    title: 'APIs & integrations',
    body: 'Documented REST APIs and the integrations around them — payments, email, storage, third parties.',
  },
  {
    icon: 'cloud' as const,
    title: 'Cloud & deployment',
    body: 'Containerised deployments with TLS, managed databases and backups that have been restored at least once.',
  },
  {
    icon: 'gauge' as const,
    title: 'Performance & SEO',
    body: 'Fast pages, semantic markup, structured data and sitemaps — the quiet work that decides whether people find you.',
  },
  {
    icon: 'wrench' as const,
    title: 'Maintenance',
    body: 'Upgrades, monitoring and small features after launch, on a monthly basis you can cancel whenever you like.',
  },
]

const work = [
  {
    name: 'Colett Precision',
    tag: 'Web platform',
    image: '/images/work-web-platform.svg',
    alt: 'Dashboard interface from a precision-engineering platform',
  },
  {
    name: 'Infinity',
    tag: 'Mobile app',
    image: '/images/work-mobile-app.svg',
    alt: 'Two phone screens from a cross-platform mobile application',
  },
  {
    name: 'Unity Workspace',
    tag: 'Brand & print',
    image: '/images/unity.jpg',
    alt: 'Printed brand collateral laid out on a studio desk',
  },
]

const process = [
  { step: '01', title: 'Scope', body: 'We agree on what the product has to do — and what it explicitly will not.' },
  { step: '02', title: 'Design & build', body: 'Short iterations, with something clickable at the end of each one.' },
  { step: '03', title: 'Ship', body: 'Deployed to your infrastructure with TLS, backups and a written runbook.' },
  { step: '04', title: 'Maintain', body: 'Monitoring, upgrades and small features afterwards, on a schedule that suits you.' },
]
---

<Base
  title="DZ Developers — Web & Mobile Product Studio"
  description="A software studio building web and mobile applications, the APIs behind them, and the infrastructure that runs them."
>
  <!-- Hero — the studio photograph under a charcoal veil. -->
  <section class="relative isolate overflow-hidden bg-ink-900">
    <img
      src="/images/hero-image.jpg"
      alt=""
      width="3000"
      height="2143"
      class="absolute inset-0 -z-10 h-full w-full object-cover object-[68%_50%]"
      aria-hidden="true"
    />
    <div class="absolute inset-0 -z-10 bg-ink-900/75" aria-hidden="true"></div>
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-b from-ink-900/45 via-transparent to-ink-900/75"
      aria-hidden="true"
    >
    </div>

    <div class="wrap relative py-24 text-center sm:py-32">
      <p class="eyebrow text-brand-200" data-reveal>Web &amp; mobile product studio</p>

      <h1 class="t-hero mx-auto mt-6 max-w-4xl text-white" data-reveal style="--reveal-delay:70ms">
        We build software that brings usability, beauty and great impact.
      </h1>

      <p
        class="t-lead mx-auto mt-7 max-w-2xl text-white/80"
        data-reveal
        style="--reveal-delay:140ms"
      >
        A studio in Algeria designing and building web and mobile products — the
        APIs behind them, and the infrastructure that keeps them running.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4" data-reveal style="--reveal-delay:210ms">
        <a href="/contact" class="btn btn-solid">Start a project</a>
        <a href="/services" class="btn btn-outline">What we do</a>
      </div>
    </div>

    <!-- Thin fact strip, ruled like the template's metadata rows. -->
    <div class="relative border-t border-white/10">
      <div class="wrap grid grid-cols-2 gap-y-4 py-5 text-center sm:grid-cols-4">
        {
          [
            ['Focus', 'Web & mobile'],
            ['Stack', 'Django · Flutter'],
            ['Infrastructure', 'Docker · PostgreSQL'],
            ['Based in', 'Algeria'],
          ].map(([label, value]) => (
            <div>
              <p class="text-[10px] uppercase tracking-[0.2em] text-white/45">{label}</p>
              <p class="mt-1 text-[13.5px] text-white/85">{value}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- "What we provide" — the green lattice band with six icon boxes. -->
  <section class="band-green pattern-geo" aria-labelledby="services-heading">
    <div class="wrap py-20">
      <h2 id="services-heading" class="t-h2 text-white" data-reveal>What we provide</h2>
      <p class="mt-4 max-w-2xl text-[15px] leading-[1.9] text-white/75" data-reveal style="--reveal-delay:80ms">
        One studio for the whole product: the interface, the API, the database,
        the deployment and the person who answers when something breaks.
      </p>

      <ul class="mt-14 grid gap-x-12 sm:grid-cols-3">
        {
          services.map((service, index) => (
            <li
              class={`py-10 ${index > 2 ? 'border-t border-white/20' : ''}`}
              data-reveal
              style={`--reveal-delay:${(index % 3) * 70}ms`}
            >
              <span class="icon-ring text-white/85">
                <Icon name={service.icon} size={26} />
              </span>
              <h3 class="mt-6 font-display text-[20px] font-light">
                <a href="/services" class="u-title">{service.title}</a>
              </h3>
              <p class="mt-3 text-[13.5px] leading-[1.9] text-white/70">{service.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Selected work -->
  <section class="section" aria-labelledby="work-heading">
    <div class="wrap">
      <div class="text-center" data-reveal>
        <p class="eyebrow text-ink-400">Selected work</p>
        <h2 id="work-heading" class="t-h2 mt-4">Products in production</h2>
        <hr class="rule mx-auto mt-8 w-16 border-brand-500" />
      </div>

      <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          work.map((project, index) => (
            <article data-reveal style={`--reveal-delay:${index * 90}ms`}>
              <a href="/contact" class="tile block aspect-[4/3]" aria-label={`${project.name} — ${project.tag}`}>
                <img src={project.image} alt={project.alt} width="1200" height="900" loading="lazy" decoding="async" />
                <span class="tile-veil"></span>
              </a>
              <div class="mt-5 text-center">
                <h3 class="font-display text-[20px] font-light">
                  <a href="/contact" class="u-title">{project.name}</a>
                </h3>
                <p class="mt-3 text-[10.5px] uppercase tracking-[0.2em] text-ink-400">{project.tag}</p>
              </div>
            </article>
          ))
        }
      </div>

      <p class="mt-14 text-center" data-reveal>
        <a href="/contact" class="link-more text-brand-500 hover:text-brand-700">
          Talk about your project
          <Icon name="arrow-right" size={14} />
        </a>
      </p>
    </div>
  </section>

  <!-- Full-width photograph, as the template puts between sections. -->
  <PhotoStrip />

  <!-- The studio -->
  <section class="band-light pattern-geo-light" aria-labelledby="office-heading">
    <div class="wrap grid gap-10 py-20 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div data-reveal>
        <p class="eyebrow text-ink-400">The studio</p>
        <h2 id="office-heading" class="t-h2 mt-4">Small on purpose</h2>
      </div>

      <div data-reveal style="--reveal-delay:100ms">
        <p class="text-[15px] leading-[1.9] text-ink-500">
          We stay small so that the person you explain the problem to is the
          person writing the code. Nothing important has to survive a handover,
          and nothing gets lost between a sales team and a delivery team.
        </p>
        <p class="mt-4 text-[15px] leading-[1.9] text-ink-500">
          Most of our work is long-lived: products that have to keep functioning
          after launch, with real users, real data and a real budget.
        </p>
        <a href="/about" class="link-more mt-8 text-brand-500 hover:text-brand-700">
          More about the studio
          <Icon name="arrow-right" size={14} />
        </a>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section" aria-labelledby="process-heading">
    <div class="wrap">
      <div class="text-center" data-reveal>
        <p class="eyebrow text-ink-400">How we work</p>
        <h2 id="process-heading" class="t-h2 mt-4">No surprises, no black boxes</h2>
        <hr class="rule mx-auto mt-8 w-16 border-brand-500" />
      </div>

      <ol class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          process.map((item, index) => (
            <li class="border-t border-ink-200 pt-6" data-reveal style={`--reveal-delay:${index * 70}ms`}>
              <span class="font-display text-[38px] font-light leading-none text-brand-500/60">{item.step}</span>
              <h3 class="mt-4 font-display text-[19px] font-light text-ink-700">{item.title}</h3>
              <p class="mt-3 text-[13.5px] leading-[1.9] text-ink-500">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBand title="Have something that needs building?" />

  <!-- Contact strip — three ruled columns, as in the template's footer lead-in. -->
  <section class="border-t border-ink-100" aria-label="Contact details">
    <div class="wrap grid gap-8 py-14 sm:grid-cols-3">
      <div>
        <h2 class="text-[10.5px] uppercase tracking-[0.2em] text-ink-400">Email us</h2>
        <a
          href={`mailto:${EMAIL}`}
          class="mt-3 inline-block border-b border-ink-200 pb-1 font-display text-[18px] font-light text-ink-700 no-underline transition-colors hover:border-brand-500 hover:text-brand-500"
        >
          {EMAIL}
        </a>
      </div>
      <div>
        <h2 class="text-[10.5px] uppercase tracking-[0.2em] text-ink-400">Start a project</h2>
        <a
          href="/contact"
          class="mt-3 inline-block border-b border-ink-200 pb-1 font-display text-[18px] font-light text-ink-700 no-underline transition-colors hover:border-brand-500 hover:text-brand-500"
        >
          Tell us about the work
        </a>
      </div>
      <div>
        <h2 class="text-[10.5px] uppercase tracking-[0.2em] text-ink-400">Where we are</h2>
        <p class="mt-3 font-display text-[18px] font-light text-ink-700">Algeria — working remotely</p>
      </div>
    </div>
  </section>
</Base>
