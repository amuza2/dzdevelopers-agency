---
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'
import CtaBand from '../components/CtaBand.astro'
import Address from '../components/Address.astro'
import Icon from '../components/Icon.astro'

const values = [
  {
    title: 'Boring where it counts',
    body: 'Predictable infrastructure, tested deployments and backups that have been restored at least once. Excitement belongs in the product, not the platform.',
  },
  {
    title: 'One team, start to finish',
    body: 'The people who scope the work are the people who build and maintain it. No relay race, no account manager repeating your brief.',
  },
  {
    title: 'Written down',
    body: 'Decisions, runbooks and access details live in the repository, not in somebody’s head. Handover is a document you can read.',
  },
]

const facts = [
  { label: 'Focus', value: 'Web & mobile products' },
  { label: 'Core stack', value: 'Django · Vue · Flutter' },
  { label: 'Infrastructure', value: 'Docker · PostgreSQL' },
  { label: 'Based in', value: 'Algeria, remote' },
]
---

<Base
  title="About — DZ Developers"
  description="A small software studio building web and mobile applications, the APIs behind them, and the infrastructure that runs them."
>
  <PageHeader
    eyebrow="About"
    title="A small studio, deliberately"
    lead="We build web and mobile applications, the APIs behind them, and the infrastructure that keeps them running."
  />

  <section class="section">
    <div class="wrap grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div data-reveal>
        <p class="eyebrow text-ink-400">The studio</p>
        <h2 class="t-h2 mt-4">Close to the work, close to you</h2>
      </div>

      <div class="space-y-5 text-[15px] leading-[1.9] text-ink-500" data-reveal style="--reveal-delay:100ms">
        <p>
          DZ Developers is a software studio. We design and build web and mobile
          applications, the APIs behind them, and the infrastructure that keeps
          them running.
        </p>
        <p>
          We stay small on purpose. It means the person you explain the problem
          to is the person writing the code, and that nothing important has to
          survive a handover between teams.
        </p>
        <p>
          Most of our work is long-lived: products that have to keep functioning
          after launch, with real users, real data and a real budget.
        </p>
      </div>
    </div>
  </section>

  <!-- Full-width photograph, as the template puts between sections. -->
  <section class="relative isolate overflow-hidden bg-ink-900" aria-hidden="true">
    <img
      src="/images/home_agency_section_2.jpg"
      alt=""
      width="1920"
      height="867"
      class="h-[220px] w-full object-cover sm:h-[340px]"
      loading="lazy"
      decoding="async"
    />
  </section>

  <!-- Facts, ruled like the template's metadata rows. -->
  <div class="border-y border-ink-100">
    <dl class="wrap grid grid-cols-2 gap-y-8 py-10 sm:grid-cols-4">
      {
        facts.map((fact) => (
          <div>
            <dt class="text-[10.5px] uppercase tracking-[0.2em] text-ink-400">{fact.label}</dt>
            <dd class="mt-2 font-display text-[17px] font-light text-ink-700">{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <!-- Where the studio is -->
  <section class="section" aria-labelledby="location-heading">
    <div class="wrap grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div data-reveal>
        <p class="eyebrow text-ink-400">Find us</p>
        <h2 id="location-heading" class="t-h2 mt-4">The studio in Hadjout</h2>

        <Address class="mt-6 text-[15px] leading-[1.9] text-ink-500" />

        <a
          href="https://www.google.com/maps?q=36.50607717760867,2.4175567190652605"
          target="_blank"
          rel="noopener noreferrer"
          class="link-more mt-6 text-brand-500 hover:text-brand-700"
        >
          Open in Google Maps
          <Icon name="arrow-up-right" size={14} />
        </a>
      </div>

      <div class="border border-ink-200" data-reveal style="--reveal-delay:100ms">
        <iframe
          src="https://www.google.com/maps?q=36.50607717760867,2.4175567190652605&z=15&hl=en&output=embed"
          title="Map showing the DZ Developers studio in Hadjout, Tipaza"
          class="h-[320px] w-full border-0 sm:h-[420px]"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <!-- Values on the light lattice band. -->
  <section class="band-light pattern-geo-light" aria-labelledby="values-heading">
    <div class="wrap py-20">
      <div class="text-center" data-reveal>
        <p class="eyebrow text-ink-400">How we work</p>
        <h2 id="values-heading" class="t-h2 mt-4">Three rules we do not bend</h2>
        <hr class="rule mx-auto mt-8 w-16 border-brand-500" />
      </div>

      <ul class="mt-14 grid gap-10 sm:grid-cols-3">
        {
          values.map((value, index) => (
            <li class="border-t border-ink-200 pt-6" data-reveal style={`--reveal-delay:${index * 80}ms`}>
              <span class="font-display text-[34px] font-light leading-none text-brand-500/60">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-4 font-display text-[19px] font-light text-ink-700">{value.title}</h3>
              <p class="mt-3 text-[13.5px] leading-[1.9] text-ink-500">{value.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Closing statement band. -->
  <section class="relative isolate overflow-hidden bg-ink-900">
    <img
      src="/images/home_agency_section_2.jpg"
      alt=""
      width="1920"
      height="867"
      class="absolute inset-0 -z-10 h-full w-full object-cover opacity-25"
      aria-hidden="true"
    />
    <div class="absolute inset-0 -z-10 bg-ink-900/60" aria-hidden="true"></div>
    <div class="wrap py-16 text-center">
      <h2 class="mx-auto max-w-3xl font-display text-[22px] font-light leading-[1.6] text-white sm:text-[26px]" data-reveal>
        You talk to the engineer, not a sales team
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-[14px] leading-[1.9] text-white/60" data-reveal style="--reveal-delay:80ms">
        Short calls, written updates, and a repository you have access to from
        day one. If something is going to slip, you hear it early.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4" data-reveal style="--reveal-delay:140ms">
        <a href="/contact" class="btn btn-outline">Start a project</a>
        <a href="/team" class="btn btn-outline">Meet the team</a>
      </div>
    </div>
  </section>

  <CtaBand
    title="Want to work together?"
    lead="Tell us what you are trying to build. If we are not the right fit, we will say so."
  />
</Base>
