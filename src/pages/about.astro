---
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'
import CtaBand from '../components/CtaBand.astro'

const values = [
  {
    title: 'Boring where it counts',
    body: 'Predictable infrastructure, tested deployments and backups that have been restored at least once.',
  },
  {
    title: 'One team, start to finish',
    body: 'The people who scope the work are the people who build and maintain it. No relay race.',
  },
  {
    title: 'Written down',
    body: 'Decisions, runbooks and access details live in the repo, not in someone\u2019s head.',
  },
]
---

<Base
  title="About — DZ Developers"
  description="A small software studio focused on web applications, APIs and the infrastructure that runs them."
>
  <PageHeader
    eyebrow="About"
    title="A small studio, deliberately"
    lead="We build web applications, the APIs behind them, and the infrastructure that keeps them running."
  />

  <section class="wrap py-16 sm:py-20">
    <div class="grid items-start gap-12 lg:grid-cols-2">
      <div class="space-y-5 text-[14px] leading-[24px] text-ink-500">
        <p>
          DZ Developers is a software studio. We build web applications, the APIs
          behind them, and the infrastructure that keeps them running.
        </p>
        <p>
          We stay small on purpose. It means the person you explain the problem to
          is the person writing the code, and that nothing important has to survive
          a handover.
        </p>
        <p>
          Most of our work is long-lived: products that have to keep functioning
          after launch, with real users and real data.
        </p>
      </div>
      <img
        src="/images/about_awards.png"
        alt="DZ Developers team and awards"
        width="900"
        height="600"
        class="w-full object-cover"
        loading="lazy"
        decoding="async"
      />
    </div>
  </section>

  <section class="band-light">
    <div class="wrap py-16 sm:py-20">
      <div class="flex items-center gap-8">
        <h2 class="h-section shrink-0 text-[26px] sm:text-[30px]">How we work</h2>
        <hr class="rule flex-1" />
      </div>
      <ul class="mt-12 grid gap-10 sm:grid-cols-3">
        {
          values.map((value, index) => (
            <li class="border-t border-ink-100 pt-6">
              <span class="block text-[40px] font-light leading-none text-brand-200">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="h-card mt-5 text-[21px]">
                <span class="u-title">{value.title}</span>
              </h3>
              <p class="mt-3 text-[13px] leading-[23px] text-ink-500">{value.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand
    title="Want to work together?"
    lead="Tell us what you are trying to build. If we are not the right fit, we will say so."
    label="Get in touch"
  />
</Base>
