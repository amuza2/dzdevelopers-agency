---
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'
import CtaBand from '../components/CtaBand.astro'
import Icon from '../components/Icon.astro'

const values = [
  {
    icon: 'shield' as const,
    title: 'Boring where it counts',
    body: 'Predictable infrastructure, tested deployments, and backups that have been restored at least once. Excitement belongs in the product, not the platform.',
  },
  {
    icon: 'server' as const,
    title: 'One team, start to finish',
    body: 'The people who scope the work are the people who build and maintain it. No relay race, no account manager repeating your brief.',
  },
  {
    icon: 'sparkles' as const,
    title: 'Written down',
    body: 'Decisions, runbooks and access details live in the repository, not in somebody’s head. Handover is a document you can read.',
  },
]

const facts = [
  { label: 'Focus', value: 'Web & mobile products' },
  { label: 'Core stack', value: 'Django · Vue · Flutter' },
  { label: 'Infrastructure', value: 'Docker · PostgreSQL' },
  { label: 'Based in', value: 'Algeria, remote' },
]
---

<Base
  title="About — DZ Developers"
  description="A small software studio building web and mobile applications, the APIs behind them, and the infrastructure that runs them."
>
  <PageHeader
    eyebrow="About"
    title="A small studio, deliberately"
    lead="We build web and mobile applications, the APIs behind them, and the infrastructure that keeps them running."
  />

  <section class="section">
    <div class="wrap grid items-start gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
      <div data-reveal>
        <p class="eyebrow text-brand-600">The studio</p>
        <h2 class="t-h2 mt-5">Close to the work, close to you.</h2>

        <div class="mt-7 space-y-5 text-[15px] leading-[1.8] text-ink-500">
          <p>
            DZ Developers is a software studio. We design and build web and
            mobile applications, the APIs behind them, and the infrastructure
            that keeps them running.
          </p>
          <p>
            We stay small on purpose. It means the person you explain the problem
            to is the person writing the code, and that nothing important has to
            survive a handover between teams.
          </p>
          <p>
            Most of our work is long-lived: products that have to keep
            functioning after launch, with real users, real data and a real
            budget.
          </p>
        </div>

        <dl class="mt-10 grid grid-cols-2 gap-x-8 gap-y-6 border-t border-ink-100 pt-8">
          {
            facts.map((fact) => (
              <div>
                <dt class="font-mono text-[10px] uppercase tracking-[0.2em] text-ink-400">
                  {fact.label}
                </dt>
                <dd class="mt-2 font-display text-[15px] font-medium text-ink-950">{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <figure class="overflow-hidden rounded-[28px] border border-ink-100 bg-ink-50" data-reveal style="--reveal-delay:120ms">
        <img
          src="/images/studio-system-map.svg"
          alt="Diagram of a product architecture: web and mobile clients connected to an API layer and a database"
          width="1000"
          height="1000"
          class="aspect-square w-full object-cover"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="border-t border-ink-100 bg-white px-6 py-4 font-mono text-[10px] uppercase tracking-[0.18em] text-ink-400">
          Clients · API layer · data · infrastructure
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section hairline bg-ink-50">
    <div class="wrap">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow text-brand-600">How we work</p>
        <h2 class="t-h2 mt-5">Three rules we do not bend.</h2>
      </div>

      <ul class="mt-12 grid gap-5 sm:grid-cols-3">
        {
          values.map((value, index) => (
            <li class="card card-lift" data-reveal style={`--reveal-delay:${index * 80}ms`}>
              <span class="grid h-11 w-11 place-items-center rounded-xl bg-brand-50 text-brand-600 ring-1 ring-inset ring-brand-100">
                <Icon name={value.icon} size={20} />
              </span>
              <h3 class="t-h3 mt-6">{value.title}</h3>
              <p class="mt-3 text-[14px] leading-[1.7] text-ink-500">{value.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div
        class="relative overflow-hidden rounded-[28px] border border-ink-100 bg-white p-8 sm:p-12"
        data-reveal
      >
        <div class="pointer-events-none absolute -right-24 -top-24 h-64 w-64 rounded-full bg-brand-200/40 blur-3xl" aria-hidden="true"></div>
        <div class="relative grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
          <div>
            <p class="eyebrow text-brand-600">Working together</p>
            <h2 class="t-h2 mt-5 text-[26px] sm:text-[32px]">
              You talk to the engineer, not a sales team.
            </h2>
            <p class="mt-4 max-w-xl text-[15px] leading-[1.75] text-ink-500">
              Short calls, written updates, and a repository you have access to
              from day one. If something is going to slip, you hear it early.
            </p>
          </div>
          <div class="flex flex-wrap gap-3 lg:justify-end">
            <a href="/contact" class="btn btn-dark">
              Start a project
              <Icon name="arrow-right" size={15} />
            </a>
            <a href="/team" class="btn btn-outline">Meet the team</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title="Want to work together?"
    lead="Tell us what you are trying to build. If we are not the right fit, we will say so."
  />
</Base>
